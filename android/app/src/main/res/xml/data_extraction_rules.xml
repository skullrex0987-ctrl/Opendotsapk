<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules for Android 12 (API 31) and above. This supersedes
  android:fullBackupContent, and applies to BOTH cloud backup and
  device-to-device transfer.

  Reasons for excluding the same two domains here as in backup_rules.xml: the
  data-encryption key lives in the Android Keystore and is device-bound, so it
  cannot travel with a backup or a transfer. Encrypted rows backed up without
  their key restore to unreadable ciphertext, which looks like data loss. This
  keeps undecryptable ciphertext — and the wrapped secrets in secure prefs —
  from being extracted at all.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- localmind.db: all encrypted messages, notes, memories, chunks. -->
        <exclude domain="database" path="." />
        <!-- shared_prefs, including the flutter_secure_storage entries. -->
        <exclude domain="sharedpref" path="." />
    </cloud-backup>

    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
